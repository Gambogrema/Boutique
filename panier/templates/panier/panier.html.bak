<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Mon panier - Ma Boutique</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: #f5f5f5;
            color: #222;
        }

        header {
            background: #111827;
            color: white;
            padding: 20px;
            text-align: center;
        }

        header h1 {
            margin: 0;
        }

        .container {
            max-width: 900px;
            margin: auto;
            padding: 20px;
        }

        .produit {
            background: white;
            padding: 18px;
            margin-bottom: 15px;
            border-radius: 12px;
            box-shadow: 0 3px 10px rgba(0, 0, 0, 0.08);
        }

        .produit h2 {
            margin-top: 0;
        }

        .prix {
            font-weight: bold;
            font-size: 18px;
        }

        .quantite {
            display: flex;
            align-items: center;
            gap: 12px;
            margin: 15px 0;
        }

        .quantite a {
            display: inline-flex;
            width: 40px;
            height: 40px;
            align-items: center;
            justify-content: center;
            background: #e5e7eb;
            border-radius: 8px;
            text-decoration: none;
            font-size: 20px;
        }

        .nombre {
            font-size: 18px;
            font-weight: bold;
        }

        .supprimer {
            color: #dc2626;
            text-decoration: none;
        }

        .total {
            background: white;
            padding: 20px;
            border-radius: 12px;
            margin-top: 20px;
            box-shadow: 0 3px 10px rgba(0, 0, 0, 0.08);
        }

        .total h2 {
            margin-top: 0;
        }

        .commande {
            display: block;
            text-align: center;
            background: #16a34a;
            color: white;
            text-decoration: none;
            padding: 14px;
            border-radius: 8px;
            font-weight: bold;
            margin-top: 15px;
        }

        .accueil {
            display: block;
            text-align: center;
            margin-top: 15px;
            color: #2563eb;
            text-decoration: none;
        }

        .vide {
            background: white;
            text-align: center;

    </style>    border-radius: 10px;

<body>

<header>
.image-produit {
    width: 120px !important;
    height: 120px !important;
    max-width: 120px !important;
    max-height: 120px !important;
    object-fit: cover;
    display: block;
    margin: 0 auto 15px;
    border-radius: 10px;
}

.sans-image {
    width: 120px;
    height: 120px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 15px;
    background: #e5e7eb;
    color: #6b7280;
    border-radius: 10px;
    text-align: center;
}
</style>    <h1>🛒 Mon panier</h1>
.image-produit {
    width: 120px !important;
    height: 120px !important;
    max-width: 120px !important;
    max-height: 120px !important;
    object-fit: cover;
    display: block;
    margin: 0 auto 15px;
    border-radius: 10px;
}

.sans-image {
    width: 120px;
    height: 120px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 15px;
    background: #e5e7eb;
    color: #6b7280;
    border-radius: 10px;
    text-align: center;
}</header>

<div class="container">

    {% if produits %}

        {% for item in produits %}

            <div class="produit">

                <h2>{{ item.produit.nom }}</h2>

<p class="prix">
    Prix unitaire : {{ item.produit.prix }} FCFA
</p>
                <div class="quantite">

                    <a href="{% url 'diminuer_quantite' item.produit_id %}">
                        ➖
                    </a>

{% if item.produit.image %}
    <img src="{{ item.produit.image.url }}"
         alt="{{ item.produit.nom }}"
         class="image-produit">
{% else %}
    <div class="sans-image">
        Aucune image
    </div>
{% endif %}                    <span class="nombre">
                        {{ item.quantite }}
                    </span>

                    <a href="{% url 'augmenter_quantite' item.produit_id %}">
                        ➕
                    </a>

                </div>

<p>
    {{ item.produit.prix }} FCFA × {{ item.quantite }}
    =
    <strong>{{ item.sous_total }} FCFA</strong>
</p>
                <a class="supprimer"
                   href="{% url 'supprimer_du_panier' item.produit_id %}">
                    🗑️ Supprimer
                </a>

            </div>

        {% endfor %}

        <div class="total">

            <h2>
                Total : {{ total }} FCFA
            </h2>

            <a class="commande"
               href="{% url 'passer_commande' %}">
                🧾 Passer la commande
            </a>

        </div>

    {% else %}

        <div class="vide">

            <h2>🛒 Votre panier est vide</h2>

            <p>
                Ajoutez des produits à votre panier pour commencer.
            </p>

        </div>

    {% endif %}

    <a class="accueil"
       href="{% url 'accueil' %}">
        ← Continuer mes achats
    </a>

</div>

</body>
</html>
